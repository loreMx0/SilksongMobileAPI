<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SilksongMobileAPI.CecilCore</AssemblyName>
    <Version>1.0.0.0</Version>
    <LangVersion>latest</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>/home/lorem/Projects/SilksongMobileAPI/.tmp_build/CecilCore</OutputPath>
    <DebugType>none</DebugType>
    <NoWarn>CS0436;CS0618;CS0169;CS0649;CS0414;CS0108;CS0067;CS0162;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CecilEngine.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>/home/lorem/Projects/lib/Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
